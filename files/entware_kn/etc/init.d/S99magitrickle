#!/bin/sh

ENABLED=yes
PROCS=magitrickled
ARGS=""
PREARGS=""
DESC="MagiTrickle Daemon"
PATH=/opt/sbin:/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UPTIME_MAX_BORDER=300
READY_TIMEOUT=60
SOCKET_PATH=/opt/var/run/magitrickle.sock

ACTION=$1
CALLER=$2

ansi_red="\033[1;31m";
ansi_white="\033[1;37m";
ansi_green="\033[1;32m";
ansi_yellow="\033[1;33m";
ansi_blue="\033[1;34m";
ansi_bell="\007";
ansi_blink="\033[5m";
ansi_std="\033[m";
ansi_rev="\033[7m";
ansi_ul="\033[4m";

get_uptime() {
    cut -d. -f1 /proc/uptime
}

wait_for_routing() {
  routing_pid=$1
  routing_failure="routing readiness timed out after ${READY_TIMEOUT}s"
  deadline=$(( $(get_uptime) + READY_TIMEOUT ))
  while [ "$(get_uptime)" -lt "$deadline" ]; do
    if [ -n "$routing_pid" ]; then
      if ! kill -0 "$routing_pid" 2>/dev/null; then
        routing_failure="daemon exited before routing was ready"
        return 1
      fi
    else
      if ! pidof "$PROC" >/dev/null 2>&1; then
        routing_failure="daemon exited before routing was ready"
        return 1
      fi
    fi
    # Readiness includes the initial Keenetic policy resolution and its
    # applied netfilter generation; optional DNS history is unrelated.
    response=$(
      printf 'GET /api/v1/system/ready HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' |
        socat -T 1 - UNIX-CONNECT:"$SOCKET_PATH",connect-timeout=1 2>/dev/null
    )
    case "$response" in
      'HTTP/1.1 200 '*|'HTTP/1.0 200 '*) return 0 ;;
    esac
    sleep 1
  done
  return 1
}

startup_loop() {
  $PRECMD > /dev/null 2>&1
  STEP=5
  COUNTER=0
  while :; do
    if [ "`get_uptime`" -gt "$UPTIME_MAX_BORDER" ]; then
      break
    fi
    if [ -n "`pidof $PROC`" ]; then
      sleep $STEP
      continue
    fi

    logger "Starting $DESC from $CALLER (Attempt #`expr $COUNTER + 1`)."
    $PROC > /dev/null 2>&1 &
    sleep $STEP
    if [ -z "`pidof $PROC`" ]; then
      logger "Failed to start $DESC from $CALLER (Attempt #`expr $COUNTER + 1`)."
    fi
    COUNTER=`expr $COUNTER + 1`
  done

  if [ -z "`pidof $PROC`" ]; then
    logger "Failed to start $DESC from $CALLER."
    return 255
  else
    logger "Started $DESC from $CALLER."
    return 0
  fi
}

start() {
  [ "$CRITICAL" != "yes" -a "$CALLER" = "cron" ] && return 7
  [ "$ENABLED" != "yes" ] && return 8
  echo -e -n "$ansi_white Starting $DESC... $ansi_std"

  started_pid=
  if ! pidof "$PROC" >/dev/null 2>&1; then
    if [ "$ACTION" != restart ] && [ "$(get_uptime)" -le "$UPTIME_MAX_BORDER" ]; then
      echo -e "            $ansi_yellow in loop (until uptime $UPTIME_MAX_BORDER)... $ansi_std"
      startup_loop &
      return 0
    fi
    $PRECMD > /dev/null 2>&1
    $PREARGS $PROC $ARGS > /dev/null 2>&1 &
    started_pid=$!
  fi

  if ! wait_for_routing "$started_pid"; then
    echo -e "            $ansi_red failed: $routing_failure. $ansi_std"
    logger "Failed to start $DESC from $CALLER: $routing_failure."
    return 255
  fi

  if [ -n "$started_pid" ]; then
    $POSTCMD > /dev/null 2>&1
    echo -e "            $ansi_green done. $ansi_std"
    logger "Started $DESC from $CALLER."
  else
    echo -e "            $ansi_yellow already running. $ansi_std"
  fi
  return 0
}

stop() {
  echo -e -n "$ansi_white Shutting down $PROC... $ansi_std"
  killall $PROC 2>/dev/null
  COUNTER=0
  LIMIT=10
  while [ -n "`pidof $PROC`" -a "$COUNTER" -le "$LIMIT" ]; do
    sleep 1;
    COUNTER=`expr $COUNTER + 1`
  done

  if [ -n "`pidof $PROC`" ]; then
    echo -e "            $ansi_red failed. $ansi_std"
    return 255
  else
    echo -e "            $ansi_green done. $ansi_std"
    return 0
  fi
}

check() {
  echo -e -n "$ansi_white Checking $DESC... $ansi_std"
  if [ -n "`pidof $PROC`" ]; then
    echo -e "            $ansi_green alive. $ansi_std";
    return 0
  else
    echo -e "            $ansi_red dead. $ansi_std";
    return 1
  fi
}

reconfigure() {
  SIGNAL=SIGHUP
  echo -e "$ansi_white Sending $SIGNAL to $PROC... $ansi_std"
  killall -$SIGNAL $PROC 2>/dev/null
}

for PROC in $PROCS; do
  case $ACTION in
    start)
      start
      ;;
    stop)
      check && stop
      ;;
    restart)
      if check > /dev/null; then
        stop || exit $?
      fi
      start
      ;;
    check|status)
      check
      ;;
    reconfigure)
      reconfigure
      ;;
    *)
      echo -e "$ansi_white Usage: $0 (start|stop|restart|check|status|reconfigure)$ansi_std"
      exit 1
      ;;
  esac
done
